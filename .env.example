OBSIDIAN_VAULT_PATH=./vaults/vault
OBSIDIAN_VAULTS_ROOT=./vaults
WEB_DEFAULT_VAULT=vault
# Vault hot discovery (W4 #437) — OFF by default. With false the process creates no watch handle, no
# directory stat and no timer: a new directory under the Vaults root is only picked up by the explicit
# Admin refresh. Turning it on arms the directory watcher + the bounded periodic scan; a newly found
# directory still lands as `pending` and is NOT authorized — an administrator must approve it, and the
# existing scope/allowedVaults rules still apply. The parent directory must be mounted INTO the
# container (hot discovery cannot cross the Docker mount namespace). Diagnostics: GET /healthz ->
# vaultDiscovery. Roll back by setting this to false and restarting: only the automatic triggers stop,
# the admission record keeps its authority. Details: docs/USER_CONFIGURATION.md -> Multi-Vault ->
# "Automatic discovery (hot discovery, opt-in)".
VAULT_DISCOVERY_ENABLED=false
# Optional tuning, read only when VAULT_DISCOVERY_ENABLED=true (frozen defaults; out-of-range values
# are clamped, non-numeric values fall back to the default). They are forwarded by docker-compose.yaml
# with these same defaults; `app/test/discovery-compose-config.test.js` asserts the two files agree.
VAULT_DISCOVERY_DEBOUNCE_MS=500
VAULT_DISCOVERY_MAX_COALESCE_MS=5000
VAULT_DISCOVERY_PERIODIC_SECONDS=60
VAULT_DISCOVERY_PERIODIC_MAX_SECONDS=900
MCP_PORT=18923
MCP_SERVER_VERSION=1.0.0
OBSIDIAN_READ_ONLY=false
API_KEY=
API_KEY_HEADER=X-API-Key
OAUTH_ENABLED=false
# Required only for OAuth. Use the externally reachable HTTPS origin, without /mcp.
PUBLIC_BASE_URL=
# Put the real value only in .env or another protected secret source.
OAUTH_ADMIN_PASSWORD=
# Used once to seed the first OAuth login account. Manage/rotate it at /admin/auth afterwards.
OAUTH_INITIAL_USERNAME=
OAUTH_INITIAL_PASSWORD=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_REFRESH_REUSE_GRACE_SECONDS=30
AUTH_AUDIT_MAX_ENTRIES=2000
AUTH_ADMIN_SESSION_TTL_SECONDS=3600
# AuthZ time-window access control: off is zero behavior difference; when enabled the policy file is DATA_PATH/access-policy.json; roll back by setting this to false and restarting (keep the file; it is inert while off).
AUTHZ_ENABLED=false
PROTECT_HEALTH=false
# Progressive Tool Discovery operator profile: full (default) | core | module | custom.
# Absent or invalid values fall back to full with a bounded warning.
MCP_DISCOVERY_PROFILE=full
# For profile=module: comma-separated toolsets (info,notes,search,files,links,workflows,git,intelligence,publish,plans).
MCP_DISCOVERY_TOOLSETS=
# For profile=custom: comma-separated canonical tool names.
MCP_DISCOVERY_TOOLS=
# Any profile: comma-separated canonical tool names to always hide.
MCP_DISCOVERY_DENY_TOOLS=
JSON_LIMIT=25mb
CORS_ORIGIN=*
# Comma-separated Express trusted proxy IPs/CIDRs. Include every direct ingress peer
# (for example the Docker gateway and an FRP client host), never use true.
TRUST_PROXY=false
DEFAULT_SEARCH_LIMIT=25
MAX_SEARCH_LIMIT=200
MAX_LIST_ENTRIES=1000
MAX_READ_BYTES=10mb
MAX_TRANSFER_BYTES=100mb
MAX_INLINE_TRANSFER_BYTES=5mb
TRANSFER_CHUNK_BYTES=1mb
TRANSFER_TTL_MS=86400000
MAX_ARCHIVE_ENTRIES=1000
MAX_ARCHIVE_BYTES=100mb
MAX_ARCHIVE_UNCOMPRESSED_BYTES=250mb
# Idle lifetime of an in-memory MCP session. Each live session holds a full MCP
# server (~3.7 MB RSS measured on the 86-tool catalog), so raise this only together
# with a session cap; hosts that outlive it are served by MCP_SESSION_RECOVERY.
SESSION_TTL_MS=1800000
# Stale-session recovery for hosts that keep sending an expired/unknown session id
# instead of re-initializing: off | stateless.
MCP_SESSION_RECOVERY=stateless
# Concurrent stateless recoveries before falling back to the strict 404. Each one
# holds a short-lived MCP server (~3.7 MB RSS) for the duration of its request, so
# the theoretical transient ceiling is roughly this value times that figure.
MCP_SESSION_RECOVERY_MAX_INFLIGHT=64
OBSIDIAN_TIMEZONE=Asia/Shanghai
VERSION_HISTORY_ENABLED=true
MAX_VERSIONS_PER_FILE=50
# Per-vault overrides are saved by the Admin page (Auth Center -> "Vault 与 Git") into
# DATA_PATH/git-vaults.json. These values stay the baseline for a primary Vault with no saved
# record; a secondary Vault with no record is disabled by default. See docs/ADMIN_VAULT_GIT.md.
GIT_ENABLED=true
GIT_AUTO_COMMIT=true
GIT_COMMIT_DEBOUNCE_SECONDS=180
GIT_COMMIT_MAX_DELAY_SECONDS=900
GIT_AUTO_COMMIT_SWEEP=true
GIT_SWEEP_INTERVAL_SECONDS=900
GIT_AUTO_PUSH=false
GIT_AUTHOR_NAME=Obsidian MCP
GIT_AUTHOR_EMAIL=obsidian-mcp@local
GIT_REMOTE=origin
GIT_BRANCH=
NODE_IMAGE=docker.m.daocloud.io/library/node:22.16-alpine
NPM_REGISTRY=https://registry.npmmirror.com
RETRIEVAL_CHUNK_SIZE=1400
RETRIEVAL_CHUNK_OVERLAP=180
# Automatically enqueue vector backfills after note changes or recall refreshes.
RETRIEVAL_AUTO_EMBED=true
RETRIEVAL_REFRESH_DEBOUNCE_MS=1000
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://127.0.0.1:11435/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_INDEX_CONCURRENCY=4
# Optional Windows/edge-PC worker. Leave empty to use NAS only.
EMBEDDING_EDGE_PROVIDER=openai
EMBEDDING_EDGE_BASE_URL=
EMBEDDING_EDGE_MODEL=qwen3-embedding-0.6b-q8
EMBEDDING_EDGE_API_KEY=
EMBEDDING_EDGE_TIMEOUT_MS=1500
EMBEDDING_EDGE_HEALTH_INTERVAL_MS=10000
EMBEDDING_EDGE_REGISTRY_URL=http://127.0.0.1:11435
EMBEDDING_EDGE_REGISTRY_API_KEY=
VAULT_WORKSPACE_ROOT=_Workspace
MEMORY_PATH=_Workspace/20-Memory
SKILLS_PATH=_Workspace/60-Skills

# Phase 1B Web Catalog (SQLite derived index). Off by default until the v2 read
# Phase 2B: the Explorer reads /api/web/v2/tree, so the SQLite catalog is enabled by
# default (WEB_CATALOG_ENABLED=false makes v2 return 503 catalog-unavailable).
WEB_CATALOG_ENABLED=true
# Directory for the derived catalog SQLite files (never inside the Vault).
# Leave empty to use `$DATA_PATH/web-catalog/<vaultId>.sqlite` (issue #428). Set it explicitly to pin
# a directory; pinning does not validate the index inside it. Two servers given the same effective
# directory and the same vault id share one file: isolate independent instances. Returning to the
# pre-#428 cwd/data/web-catalog index requires a backup, a rebuild from the Vault and verification --
# "the files were never modified" is not a safety proof. See docs/WEB_OPERATIONS.md.
WEB_CATALOG_DIR=

# Phase 4A deprecation evidence: append-only ops sink for
# `WEB_DEPRECATION_EVIDENCE_BROKEN` markers. MUST point at storage that is durable
# across container recreate/redeploy and independent of the metrics volume
# (the default per-container json-file log is deleted with the container, so it does
# not qualify). Without it, only the process logger receives the markers and the
# 7-day removal window must not start.
# WEB_DEPRECATION_OPS_LOG=/ops-log/web-deprecation.log
