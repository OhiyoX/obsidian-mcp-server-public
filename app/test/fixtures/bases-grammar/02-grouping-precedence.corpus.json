      "id": "precedence-reject-missing-closing-paren",
      "input": "(1 + 2",
      "outcome": "reject",
      "code": "syntax",
      "position": 6,
      "messageTemplate": "Expected \")\" but found {token} at position {position}",
      "note": "括号未闭合"
    },
    {
      "id": "precedence-reject-extra-closing-paren",
      "input": "1 + 2)",
      "outcome": "reject",
      "code": "syntax",
      "position": 5,
      "messageTemplate": "Unexpected token {token} at position {position}; expected end of expression",
      "note": "尾随 token（多余右括号）"
    },
    {
      "id": "precedence-reject-empty-parentheses",
      "input": "()",
      "outcome": "reject",
      "code": "syntax",
      "position": 1,
      "messageTemplate": "Expected an expression but found {token} at position {position}",
      "note": "空括号不是表达式"
    },
    {
      "id": "precedence-reject-adjacent-operators",
      "input": "1 + * 2",
      "outcome": "reject",
      "code": "syntax",
      "position": 4,
      "messageTemplate": "Expected an expression but found {token} at position {position}",
      "note": "两个运算符相邻"
    },
    {
      "id": "precedence-reject-unary-plus",
      "input": "+5",
      "outcome": "reject",
      "code": "unsupported",
      "disposition": "permanent",
      "position": 0,
      "messageTemplate": "Unsupported unary operator \"+\" at position {position}",
      "note": "官方算术表只把 `+` 记为二元 plus；一元正号未定义 → fail closed 而不是猜"
    }
  ]
