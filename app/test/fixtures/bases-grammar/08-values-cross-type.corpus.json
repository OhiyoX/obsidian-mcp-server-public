    { "id": "arithmetic-modulo-numbers", "call": "arithmetic", "operator": "%", "left": 7, "right": 4, "outcome": "accept", "result": { "type": "number", "value": 3 }, "note": "官方算术表含 `%`" },
    { "id": "arithmetic-divide-by-zero", "call": "arithmetic", "operator": "/", "left": 1, "right": 0, "outcome": "accept", "result": { "type": "missing" }, "note": "DESIGN B6#3：非有限结果归一为 missing（不是 Infinity）" },
    { "id": "arithmetic-modulo-by-zero", "call": "arithmetic", "operator": "%", "left": 1, "right": 0, "outcome": "accept", "result": { "type": "missing" }, "note": "同上（NaN → missing）" },
