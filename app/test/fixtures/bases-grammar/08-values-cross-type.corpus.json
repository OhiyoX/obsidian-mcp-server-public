    { "id": "arithmetic-add-object-number", "call": "arithmetic", "operator": "+", "left": { "a": 1 }, "right": 1, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"+\" requires two numbers or two strings but found object and number", "note": "object 参与算术 → 报错（P0 的 baseSearchableText 只用于搜索文本，不改变算术语义）" },
    { "id": "arithmetic-add-link-number", "call": "arithmetic", "operator": "+", "left": { "kind": "asLink", "path": "A.md" }, "right": 1, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"+\" requires two numbers or two strings but found link and number", "note": "structured link 参与算术 → 报错" },
    { "id": "arithmetic-add-date-duration", "call": "arithmetic", "operator": "+", "left": "2025-01-02", "right": "1d", "outcome": "reject", "code": "unsupported", "disposition": "P1-C", "messageTemplate": "Unsupported date arithmetic (\"+\" with a date value): durations need the injected clock contract (P1-C)", "note": "DOC Date arithmetic 明确支持；但 §8 要求日期函数等 injected timezone/clock 契约 → 本刀 unsupported（不是 type-mismatch）" },
    { "id": "arithmetic-subtract-dates", "call": "arithmetic", "operator": "-", "left": "2025-01-02", "right": "2025-01-01", "outcome": "reject", "code": "unsupported", "disposition": "P1-C", "messageTemplate": "Unsupported date arithmetic (\"-\" with a date value): durations need the injected clock contract (P1-C)", "note": "DOC：两日期相减得毫秒差（`now() - file.ctime`）→ 同属日期算术 → P1-C" },
    { "id": "arithmetic-multiply-date-number", "call": "arithmetic", "operator": "*", "left": "2025-01-02", "right": 2, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"*\" requires two numbers but found date and number", "note": "官方只定义日期的 `+`/`-` 时长运算；`*` 不是 → type-mismatch（不是 unsupported）" },

    { "id": "comparison-eq-numbers", "call": "comparison", "operator": "==", "left": 1, "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：Equal/not equal 可用于任意类型" },
    { "id": "comparison-ne-numbers", "call": "comparison", "operator": "!=", "left": 1, "right": 2, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "同上" },
    { "id": "comparison-eq-list", "call": "comparison", "operator": "==", "left": [1, 2], "right": [1, 2], "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "list 深度相等" },
    { "id": "comparison-eq-object", "call": "comparison", "operator": "==", "left": { "a": 1 }, "right": { "a": 1 }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "object 自有键相等" },
    { "id": "comparison-eq-link", "call": "comparison", "operator": "==", "left": { "kind": "asLink", "path": "A.md" }, "right": { "kind": "asLink", "path": "A.md", "displayName": "Alias" }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：links 用 `==`/`!=` 比较，同一文件即相等" },
    { "id": "comparison-eq-null-null", "call": "comparison", "operator": "==", "left": null, "right": null, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "B6#1" },
    { "id": "comparison-lt-numbers", "call": "comparison", "operator": "<", "left": 1, "right": 2, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：比较运算符作用于 numbers / dates" },
    { "id": "comparison-gte-numbers", "call": "comparison", "operator": ">=", "left": 2, "right": 2, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "同上" },
    { "id": "comparison-lt-strings", "call": "comparison", "operator": "<", "left": "a", "right": "b", "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DESIGN：字符串序比较沿用码元序（官方未细化）" },
    { "id": "comparison-lt-dates", "call": "comparison", "operator": "<", "left": "2025-01-02", "right": "2025-01-03", "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：dates 可用比较运算符" },
    { "id": "comparison-null-lt-number", "call": "comparison", "operator": "<", "left": null, "right": 5, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DESIGN B6#2：空值不参与大小比较，稳定 false（不是报错、也不是 JS 的 null<5=false 巧合）" },
    { "id": "comparison-number-gt-null", "call": "comparison", "operator": ">", "left": 5, "right": null, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "同上（对称）" },
    { "id": "comparison-lt-string-number", "call": "comparison", "operator": "<", "left": "5", "right": 3, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"<\" cannot compare string and number", "note": "跨类型大小比较 fail closed（JS 会做数值转换）" },
    { "id": "comparison-gt-boolean-boolean", "call": "comparison", "operator": ">", "left": true, "right": false, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \">\" cannot compare boolean and boolean", "note": "DOC 只说 numbers / dates → boolean 排序属 sort 的 TYPE_RANK（compareBaseValues），不是比较运算符" },
    { "id": "comparison-lt-date-string", "call": "comparison", "operator": "<", "left": "2025-01-02", "right": "abc", "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"<\" cannot compare date and string", "note": "date 与普通字符串不可比（避免把日期当文本比较）" },
    { "id": "comparison-lt-lists", "call": "comparison", "operator": "<", "left": [1], "right": [2], "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"<\" cannot compare list and list", "note": "list 排序用 compareBaseValues（B7），比较运算符不定义" },

    { "id": "logical-and-truthy", "call": "logical", "operator": "&&", "left": 1, "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：布尔运算符产出 true/false" },
    { "id": "logical-and-falsey-zero", "call": "logical", "operator": "&&", "left": 0, "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "P0 truthiness：0 为 falsey" },
    { "id": "logical-or-falsey-zero", "call": "logical", "operator": "||", "left": 0, "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "同上" },
    { "id": "logical-and-empty-string", "call": "logical", "operator": "&&", "left": "", "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "空串 falsey（base-formulas.isFormulaTruthy）" },
    { "id": "logical-and-empty-list", "call": "logical", "operator": "&&", "left": [], "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "空 list falsey" },
    { "id": "logical-and-empty-object", "call": "logical", "operator": "&&", "left": {}, "right": 1, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "对象沿用 P0 truthiness（对象为 truthy），与 isEmpty() 是两套语义：判定「有没有值」用 isBaseValueEmpty" },
    { "id": "logical-or-missing", "call": "logical", "operator": "||", "left": { "$missing": true }, "right": 0, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "missing falsey" },

    { "id": "unary-not-zero", "call": "unary", "operator": "!", "operand": 0, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "官方 `!completed`" },
    { "id": "unary-not-empty-string", "call": "unary", "operator": "!", "operand": "", "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "空串 falsey" },
    { "id": "unary-not-empty-list", "call": "unary", "operator": "!", "operand": [], "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "空 list falsey" },
    { "id": "unary-not-object", "call": "unary", "operator": "!", "operand": {}, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "对象 truthy → 取反 false" },
    { "id": "unary-not-missing", "call": "unary", "operator": "!", "operand": { "$missing": true }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "missing falsey" },
    { "id": "unary-negate-number", "call": "unary", "operator": "-", "operand": 5, "outcome": "accept", "result": { "type": "number", "value": -5 }, "note": "一元负号只作用于 number" },
    { "id": "unary-negate-negative", "call": "unary", "operator": "-", "operand": -5, "outcome": "accept", "result": { "type": "number", "value": 5 }, "note": "双重负号回到正数" },
    { "id": "unary-negate-zero", "call": "unary", "operator": "-", "operand": { "$number": "-0" }, "outcome": "accept", "result": { "type": "number", "value": 0 }, "note": "-0 归一为 0" },
    { "id": "unary-negate-string", "call": "unary", "operator": "-", "operand": "5", "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Unary \"-\" requires a number but found string", "note": "不做隐式数值解析" },
    { "id": "unary-negate-date", "call": "unary", "operator": "-", "operand": "2025-01-02", "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Unary \"-\" requires a number but found date", "note": "官方未定义一元负号作用于日期 → type-mismatch" },
    { "id": "unary-negate-null", "call": "unary", "operator": "-", "operand": null, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Unary \"-\" requires a number but found null", "note": "空值不冒充 0" },

    { "id": "resolve-note-property", "call": "resolve", "reference": "price", "outcome": "accept", "result": { "type": "number", "value": 3 }, "note": "裸 property = note 简写（官方 Note properties）" },
    { "id": "resolve-note-explicit-property", "call": "resolve", "reference": "note.price", "outcome": "accept", "result": { "type": "number", "value": 3 }, "note": "显式 note. 与裸 property 同值" },
    { "id": "resolve-note-missing-property", "call": "resolve", "reference": "ghost", "outcome": "accept", "result": { "type": "missing" }, "note": "缺失 frontmatter 键 → missing（官方 isEmpty「is not present」）" },
    { "id": "resolve-note-empty-string", "call": "resolve", "reference": "empty", "outcome": "accept", "result": { "type": "string", "value": "" }, "note": "空串是 string（不是 missing）" },
    { "id": "resolve-note-zero", "call": "resolve", "reference": "age", "outcome": "accept", "result": { "type": "number", "value": 0 }, "note": "0 是有值" },
    { "id": "resolve-note-false", "call": "resolve", "reference": "done", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "false 是有值" },
    { "id": "resolve-note-invalid-date", "call": "resolve", "reference": "bad", "outcome": "accept", "result": { "type": "missing" }, "note": "B6#3：非法日期字面量按 missing" },
    { "id": "resolve-file-name", "call": "resolve", "reference": "file.name", "outcome": "accept", "result": { "type": "string", "value": "Note" }, "note": "与 workflows.propertyValue 的 P0 行为一致（= record.basename）；官方的 name 含扩展名语义登记为 DEFERRED 分歧" },
    { "id": "resolve-file-basename", "call": "resolve", "reference": "file.basename", "outcome": "accept", "result": { "type": "string", "value": "Note" }, "note": "官方 File 字段表 file.basename" },
    { "id": "resolve-file-path", "call": "resolve", "reference": "file.path", "outcome": "accept", "result": { "type": "string", "value": "Folder/Note.md" }, "note": "官方 file.path（vault 相对路径）" },
    { "id": "resolve-file-folder", "call": "resolve", "reference": "file.folder", "outcome": "accept", "result": { "type": "string", "value": "Folder" }, "note": "官方 file.folder；与 P0 propertyValue 同样返回 posix 目录名（根目录为 \"\"）" },
    { "id": "resolve-file-ext", "call": "resolve", "reference": "file.ext", "outcome": "accept", "result": { "type": "string", "value": "md" }, "note": "P0 行为：恒为 \"md\"（Base 只看 Markdown 记录）；附件扩展名分歧登记 DEFERRED" },
    { "id": "resolve-file-size", "call": "resolve", "reference": "file.size", "outcome": "accept", "result": { "type": "number", "value": 12 }, "note": "官方 file.size（bytes）" },
    { "id": "resolve-file-ctime", "call": "resolve", "reference": "file.ctime", "outcome": "accept", "result": { "type": "datetime", "value": 1735689600000 }, "note": "官方 file.ctime（date）" },
    { "id": "resolve-file-mtime", "call": "resolve", "reference": "file.mtime", "outcome": "accept", "result": { "type": "datetime", "value": 1738368000000 }, "note": "官方 file.mtime（date）" },
    { "id": "resolve-file-tags", "call": "resolve", "reference": "file.tags", "outcome": "accept", "result": { "type": "list", "value": ["work"] }, "note": "官方 file.tags（list）" },
    { "id": "resolve-file-links", "call": "resolve", "reference": "file.links", "outcome": "accept", "result": { "type": "list", "value": ["Other"] }, "note": "官方 file.links（list；P0 记录里是 target 字符串）" },
    { "id": "resolve-file-backlinks", "call": "resolve", "reference": "file.backlinks", "outcome": "reject", "code": "unsupported", "disposition": "P1-C", "messageTemplate": "Unsupported file property \"file.backlinks\" (official field deferred to a later phase)", "note": "官方字段表明确说 file.backlinks 性能重 → 未实现前 fail closed，不给 missing" },
    { "id": "resolve-file-properties", "call": "resolve", "reference": "file.properties", "outcome": "reject", "code": "unsupported", "disposition": "P1-C", "messageTemplate": "Unsupported file property \"file.properties\" (official field deferred to a later phase)", "note": "同上（object 值语义未做）" },
    { "id": "resolve-file-embeds", "call": "resolve", "reference": "file.embeds", "outcome": "reject", "code": "unsupported", "disposition": "P1-C", "messageTemplate": "Unsupported file property \"file.embeds\" (official field deferred to a later phase)", "note": "同上" },
    { "id": "resolve-file-unknown-field", "call": "resolve", "reference": "file.zzz", "outcome": "reject", "code": "unsupported", "disposition": "permanent", "messageTemplate": "Unsupported file property \"file.zzz\" (unknown field)", "note": "官方字段表里没有的 file 字段（含拼写错误）→ 明确 unsupported，不静默 missing（静默会改变 filter 结果集）" },
    { "id": "resolve-formula-without-resolver", "call": "resolve", "reference": "formula.ppu", "outcome": "reject", "code": "unsupported", "disposition": "P1-B/INT-B", "messageTemplate": "Formula reference \"formula.ppu\" needs a formula resolver, which P1-A does not wire (dependency DAG is P1-B / INT-B)", "note": "依赖图属 P1-B；本刀没有 resolver 就不能假装能取值" },
    { "id": "resolve-formula-with-resolver", "call": "resolve", "reference": "formula.ppu", "formulaValues": { "ppu": 4 }, "outcome": "accept", "result": { "type": "number", "value": 4 }, "note": "注入式 resolver 契约：接口形状在 HANDOFF §接口 冻结，P1-B 的 DAG 会提供同样的值视图" },
    { "id": "resolve-formula-unknown-name", "call": "resolve", "reference": "formula.ghost", "formulaValues": { "ppu": 4 }, "outcome": "reject", "code": "unsupported", "disposition": "P1-B/INT-B", "messageTemplate": "Unsupported formula reference \"formula.ghost\" (unknown formula)", "note": "有 resolver 但公式名不存在 → fail closed（契约 §7：missing formula 一律 compile 阶段失败）" },
    { "id": "resolve-unknown-namespace", "call": "resolve", "reference": "this.file.folder", "outcome": "reject", "code": "unsupported", "disposition": "permanent", "messageTemplate": "Unsupported expression namespace \"this\" in reference \"this.file.folder\"", "note": "`this` 依赖 base 展示位置，注入式记录模型无法确定 → 永久 unsupported（契约 §4 非目标）" }
  ]
}
