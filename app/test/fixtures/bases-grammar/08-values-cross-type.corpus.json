  "valueEncoding": "裸 JSON 即原值；`{\"$missing\":true}` = undefined，`{\"$number\":\"NaN|Infinity|-Infinity|-0\"}` = 特殊 number，`{\"$date\":\"<iso>\"}` = Date 实例。",
  "record": {
    "path": "Folder/Note.md",
    "basename": "Note",
    "frontmatter": {
      "title": "T",
      "price": 3,
      "age": 0,
      "done": false,
      "empty": "",
      "iso": "2025-01-02",
      "bad": "2025-02-31",
      "ratio": 1.5
    },
    "tags": ["work"],
    "links": [{ "target": "Other" }],
    "stat": { "size": 12, "created": "2025-01-01T00:00:00Z", "modified": "2025-02-01T00:00:00Z" }
  },
  "cases": [
    { "id": "normalize-missing", "call": "normalize", "value": { "$missing": true }, "outcome": "accept", "result": { "type": "missing" }, "note": "undefined 是 missing 的唯一来源" },
    { "id": "normalize-null", "call": "normalize", "value": null, "outcome": "accept", "result": { "type": "null", "value": null }, "note": "null 单独成类（B6#1 在比较层再与 missing 合并）" },
    { "id": "normalize-number", "call": "normalize", "value": 3, "outcome": "accept", "result": { "type": "number", "value": 3 }, "note": "number" },
    { "id": "normalize-number-nan", "call": "normalize", "value": { "$number": "NaN" }, "outcome": "accept", "result": { "type": "missing" }, "note": "DESIGN B6#3：NaN 按 missing" },
    { "id": "normalize-number-infinity", "call": "normalize", "value": { "$number": "Infinity" }, "outcome": "accept", "result": { "type": "missing" }, "note": "非有限 number 一律 missing，避免污染比较/聚合" },
    { "id": "normalize-number-neg-zero", "call": "normalize", "value": { "$number": "-0" }, "outcome": "accept", "result": { "type": "number", "value": 0 }, "note": "-0 归一为 0，保证相等/排序确定" },
    { "id": "normalize-boolean", "call": "normalize", "value": true, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "boolean" },
    { "id": "normalize-string-plain", "call": "normalize", "value": "hello", "outcome": "accept", "result": { "type": "string", "value": "hello" }, "note": "普通字符串" },
    { "id": "normalize-string-whitespace", "call": "normalize", "value": " ", "outcome": "accept", "result": { "type": "string", "value": " " }, "note": "只有空白仍是 string（非 missing）；官方 isEmpty 用「没有字符」判空" },
    { "id": "normalize-date-only", "call": "normalize", "value": "2025-01-02", "outcome": "accept", "result": { "type": "date", "value": 1735776000000 }, "note": "零填充 ISO 日期 → date（UTC 午夜 epoch）" },
    { "id": "normalize-datetime-utc", "call": "normalize", "value": "2025-01-02T03:04:05Z", "outcome": "accept", "result": { "type": "datetime", "value": 1735787045000 }, "note": "带 T/Z 的 ISO 时间 → datetime" },
    { "id": "normalize-datetime-space", "call": "normalize", "value": "2025-01-02 03:04:05", "outcome": "accept", "result": { "type": "datetime", "value": 1735787045000 }, "note": "官方 date() 文档写 `YYYY-MM-DD HH:mm:ss`（空格分隔）→ 同样识别" },
    { "id": "normalize-datetime-offset", "call": "normalize", "value": "2025-01-02T03:04:05+02:00", "outcome": "accept", "result": { "type": "datetime", "value": 1735779845000 }, "note": "显式偏移按偏移换算（确定性，不依赖本机时区）" },
    { "id": "normalize-date-instance-midnight", "call": "normalize", "value": { "$date": "2025-01-02T00:00:00.000Z" }, "outcome": "accept", "result": { "type": "date", "value": 1735776000000 }, "note": "DESIGN：Date 实例的 UTC 时刻恰为午夜 → date（对齐 YAML 日期属性的静默转换）" },
    { "id": "normalize-date-instance-time", "call": "normalize", "value": { "$date": "2025-01-02T03:04:05.000Z" }, "outcome": "accept", "result": { "type": "datetime", "value": 1735787045000 }, "note": "带时刻的 Date 实例 → datetime" },
    { "id": "normalize-date-invalid-string", "call": "normalize", "value": "2025-02-31", "outcome": "accept", "result": { "type": "missing" }, "note": "DESIGN B6#3：非法日历日期按 missing（不产生回卷 epoch）" },
    { "id": "normalize-date-invalid-month", "call": "normalize", "value": "2025-13-01", "outcome": "accept", "result": { "type": "missing" }, "note": "月份越界同样 missing" },
    { "id": "normalize-date-instance-invalid", "call": "normalize", "value": { "$date": "not-a-date" }, "outcome": "accept", "result": { "type": "missing" }, "note": "Invalid Date → missing" },
    { "id": "normalize-list", "call": "normalize", "value": [1, "a"], "outcome": "accept", "result": { "type": "list", "value": [1, "a"] }, "note": "数组 → list" },
    { "id": "normalize-object", "call": "normalize", "value": { "a": 1 }, "outcome": "accept", "result": { "type": "object", "value": { "a": 1 } }, "note": "普通对象 → object" },
    { "id": "normalize-link-cell", "call": "normalize", "value": { "kind": "asLink", "path": "A.md", "displayName": "A" }, "outcome": "accept", "result": { "type": "link", "value": { "path": "A.md", "displayName": "A" } }, "note": "P0 结构化链接 cell（kind=asLink）→ link" },
    { "id": "normalize-object-without-link-kind", "call": "normalize", "value": { "path": "A.md" }, "outcome": "accept", "result": { "type": "object", "value": { "path": "A.md" } }, "note": "没有 kind=asLink 的对象仍是 object（不靠 path 猜 link）" },

    { "id": "empty-missing", "call": "empty", "value": { "$missing": true }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "B6#1：missing 为空" },
    { "id": "empty-null", "call": "empty", "value": null, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "null 为空" },
    { "id": "empty-string-empty", "call": "empty", "value": "", "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：string.isEmpty() 无字符 → true" },
    { "id": "empty-string-space", "call": "empty", "value": " ", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DOC：`\" \"` 有字符 → false" },
    { "id": "empty-number-zero", "call": "empty", "value": 0, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DOC：number.isEmpty() 只在「不存在」时为 true → 0 不算空" },
    { "id": "empty-number-nan", "call": "empty", "value": { "$number": "NaN" }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DESIGN B6#3：NaN 按 missing ⇒ 计入 Empty" },
    { "id": "empty-boolean-false", "call": "empty", "value": false, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "boolean 有值，不算空（1.10.0：null checkbox 才与 false 同序，false 本身仍是值）" },
    { "id": "empty-date", "call": "empty", "value": "2025-01-02", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DOC：date.isEmpty() Returns false（无参数可言）" },
    { "id": "empty-list-empty", "call": "empty", "value": [], "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：list.isEmpty() 无元素 → true" },
    { "id": "empty-list-nonempty", "call": "empty", "value": ["x"], "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DOC：有元素 → false" },
    { "id": "empty-object-empty", "call": "empty", "value": {}, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：object.isEmpty() 无自有键 → true" },
    { "id": "empty-object-nonempty", "call": "empty", "value": { "a": 1 }, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "DOC：有自有键 → false" },
    { "id": "empty-link", "call": "empty", "value": { "kind": "asLink", "path": "A.md" }, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "link 是有值" },

    { "id": "equal-number-vs-numeric-string", "call": "equal", "left": 1, "right": "1", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "typed 相等：不做 String() 兜底（与 legacy P0 filter 的 `String(left)===String(right)` 不同，见 HANDOFF 分歧表）" },
    { "id": "equal-missing-vs-null", "call": "equal", "left": { "$missing": true }, "right": null, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DESIGN B6#1：missing ≡ null" },
    { "id": "equal-missing-vs-empty-string", "call": "equal", "left": { "$missing": true }, "right": "", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "空串是 string，不等于 missing" },
    { "id": "equal-number-vs-boolean", "call": "equal", "left": 1, "right": true, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "不做 JS 的 1 == true" },
    { "id": "equal-number-same", "call": "equal", "left": 3, "right": 3, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "同类型同值" },
    { "id": "equal-string-case", "call": "equal", "left": "A", "right": "a", "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "字符串大小写敏感" },
    { "id": "equal-date-vs-date-instance", "call": "equal", "left": "2025-01-02", "right": { "$date": "2025-01-02T00:00:00.000Z" }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "date ≡ datetime 同刻即相等" },
    { "id": "equal-list-deep", "call": "equal", "left": [1, "a"], "right": [1, "a"], "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "list 逐元素 typed 相等（B6#5）" },
    { "id": "equal-list-different-length", "call": "equal", "left": [1], "right": [1, 2], "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "长度不同即不等" },
    { "id": "equal-object-own-keys", "call": "equal", "left": { "a": 1 }, "right": { "a": 1 }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "object 只比自有键" },
    { "id": "equal-object-extra-key", "call": "equal", "left": { "a": 1 }, "right": { "a": 1, "b": 2 }, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "键集合必须相同" },
    { "id": "equal-link-same-path", "call": "equal", "left": { "kind": "asLink", "path": "A.md", "displayName": "A" }, "right": { "kind": "asLink", "path": "A.md", "displayName": "Alias" }, "outcome": "accept", "result": { "type": "boolean", "value": true }, "note": "DOC：links 指向同一文件即相等（display 不参与）" },
    { "id": "equal-link-different-path", "call": "equal", "left": { "kind": "asLink", "path": "A.md" }, "right": { "kind": "asLink", "path": "B.md" }, "outcome": "accept", "result": { "type": "boolean", "value": false }, "note": "不同文件不等" },

    { "id": "compare-missing-first", "call": "compare", "left": { "$missing": true }, "right": 5, "outcome": "accept", "result": { "type": "number", "value": -1 }, "note": "DESIGN B6#2：空值在最小侧（ASC 在前）" },
    { "id": "compare-number-before-empty", "call": "compare", "left": 5, "right": null, "outcome": "accept", "result": { "type": "number", "value": 1 }, "note": "同上（null 也是最小侧）" },
    { "id": "compare-numbers", "call": "compare", "left": 2, "right": 10, "outcome": "accept", "result": { "type": "number", "value": -1 }, "note": "数值升序" },
    { "id": "compare-strings", "call": "compare", "left": "a", "right": "b", "outcome": "accept", "result": { "type": "number", "value": -1 }, "note": "字符串按码元序（DESIGN：确定性，locale 无关；与 P0 sort 的 localeCompare 分歧见 HANDOFF）" },
    { "id": "compare-same", "call": "compare", "left": 3, "right": 3, "outcome": "accept", "result": { "type": "number", "value": 0 }, "note": "相等返回 0" },
    { "id": "compare-number-vs-string", "call": "compare", "left": 1, "right": "1", "outcome": "accept", "result": { "type": "number", "value": -1 }, "note": "类型不同按 TYPE_RANK（number 2 < string 4），不抛错、不隐式转换（B7 DESIGN）" },
    { "id": "compare-dates", "call": "compare", "left": "2025-01-02", "right": "2025-01-03", "outcome": "accept", "result": { "type": "number", "value": -1 }, "note": "日期按 epoch 升序" },
