    { "id": "arithmetic-add-boolean-number", "call": "arithmetic", "operator": "+", "left": true, "right": 1, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"+\" requires two numbers or two strings but found boolean and number", "note": "§14.4：boolean 组合必须稳定报错或稳定 false" },
    { "id": "arithmetic-add-null-number", "call": "arithmetic", "operator": "+", "left": null, "right": 1, "outcome": "reject", "code": "type-mismatch", "messageTemplate": "Operator \"+\" requires two numbers or two strings but found null and number", "note": "JS 里 null + 1 === 1；这里 fail closed（空值不冒充 0）" },
