formulas:
  note: file.asLink(if(title, title, file.name))
views:
  - type: table
    name: Map
    filters: 'file.hasTag("project")'
    order:
      - file.name
      - status
      - formula.note
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
